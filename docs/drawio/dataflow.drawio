                <!-- Compute Engine Pipeline -->
                <mxCell id="comp_box" value="FlashAttention Compute Pipeline" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;fontStyle=1;fontSize=14;" vertex="1" parent="1">
