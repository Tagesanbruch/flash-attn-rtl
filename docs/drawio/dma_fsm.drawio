<mxfile host="65bd71144e">
    <diagram id="dma_fsm" name="DMA State Machine">
        <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="850" math="0" shadow="0">
            <root>
                <mxCell id="0" />
                <mxCell id="1" parent="0" />
                
                <mxCell id="title" value="DMA Reader / Writer 主控状态机流程" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontStyle=1;fontSize=18;" vertex="1" parent="1">
                    <mxGeometry x="360" y="40" width="370" height="30" as="geometry" />
                </mxCell>

                <!-- Reader Box -->
                <mxCell id="rd_box" value="AXI DMA Reader (fa_dma_reader)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#36393d;verticalAlign=top;fontStyle=1;fontSize=14;" vertex="1" parent="1">
                    <mxGeometry x="120" y="120" width="360" height="360" as="geometry" />
                </mxCell>

                <mxCell id="r_idle" value="AR_IDLE&#10;(等 cmd_valid)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="rd_box">
                    <mxGeometry x="120" y="50" width="120" height="60" as="geometry" />
                </mxCell>
                <mxCell id="r_send" value="AR_SEND&#10;(等待 ARREADY)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="rd_box">
                    <mxGeometry x="120" y="160" width="120" height="60" as="geometry" />
                </mxCell>
                <mxCell id="r_stream" value="AR_STREAM&#10;(RVALID &amp;amp; RREADY)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="rd_box">
                    <mxGeometry x="120" y="270" width="120" height="60" as="geometry" />
                </mxCell>

                <mxCell id="e_r1" edge="1" parent="rd_box" source="r_idle" target="r_send">
                    <mxGeometry relative="1" as="geometry" />
                </mxCell>
                <mxCell id="e_r2" edge="1" parent="rd_box" source="r_send" target="r_stream">
                    <mxGeometry relative="1" as="geometry" />
                </mxCell>
                
                <mxCell id="e_r3" edge="1" parent="rd_box" source="r_stream" target="r_send">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="60" y="300" />
                            <mxPoint x="60" y="190" />
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="lbl_burst_split" value="Burst Finished&#10;Cmd Not Done" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" vertex="1" connectable="0" parent="e_r3">
                    <mxGeometry x="-0.1" relative="1" as="geometry">
                        <mxPoint as="offset" />
                    </mxGeometry>
                </mxCell>

                <mxCell id="e_r4" edge="1" parent="rd_box" source="r_stream" target="r_idle">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="290" y="300" />
                            <mxPoint x="290" y="80" />
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="lbl_cmd_done" value="Command&#10;Fully Done" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" vertex="1" connectable="0" parent="e_r4">
                    <mxGeometry x="-0.1" relative="1" as="geometry">
                        <mxPoint as="offset" />
                    </mxGeometry>
                </mxCell>

                <!-- Writer Box -->
                <mxCell id="wr_box" value="AXI DMA Writer (fa_dma_writer)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#36393d;verticalAlign=top;fontStyle=1;fontSize=14;" vertex="1" parent="1">
                    <mxGeometry x="580" y="120" width="360" height="420" as="geometry" />
                </mxCell>

                <mxCell id="w_idle" value="W_IDLE&#10;(等 cmd_valid)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="wr_box">
                    <mxGeometry x="120" y="50" width="120" height="60" as="geometry" />
                </mxCell>
                <mxCell id="w_addr" value="W_ADDR&#10;(等待 AWREADY)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="wr_box">
                    <mxGeometry x="120" y="140" width="120" height="60" as="geometry" />
                </mxCell>
                <mxCell id="w_data" value="W_DATA&#10;(WVALID &amp;amp; WREADY)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="wr_box">
                    <mxGeometry x="120" y="230" width="120" height="60" as="geometry" />
                </mxCell>
                <mxCell id="w_resp" value="W_RESP&#10;(等待 BVALID)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="wr_box">
                    <mxGeometry x="120" y="320" width="120" height="60" as="geometry" />
                </mxCell>

                <mxCell id="e_w1" edge="1" parent="wr_box" source="w_idle" target="w_addr">
                    <mxGeometry relative="1" as="geometry" />
                </mxCell>
                <mxCell id="e_w2" edge="1" parent="wr_box" source="w_addr" target="w_data">
                    <mxGeometry relative="1" as="geometry" />
                </mxCell>
                <mxCell id="e_w3" edge="1" parent="wr_box" source="w_data" target="w_resp">
                    <mxGeometry relative="1" as="geometry" />
                </mxCell>

                <mxCell id="e_w4" edge="1" parent="wr_box" source="w_resp" target="w_addr">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="60" y="350" />
                            <mxPoint x="60" y="170" />
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="lbl_wr_split" value="Burst Finished&#10;Cmd Not Done" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" vertex="1" connectable="0" parent="e_w4">
                    <mxGeometry x="-0.1" relative="1" as="geometry">
                        <mxPoint as="offset" />
                    </mxGeometry>
                </mxCell>

                <mxCell id="e_w5" edge="1" parent="wr_box" source="w_resp" target="w_idle">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="300" y="350" />
                            <mxPoint x="300" y="80" />
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="lbl_wr_done" value="Command&#10;Fully Done" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" vertex="1" connectable="0" parent="e_w5">
                    <mxGeometry x="-0.1" relative="1" as="geometry">
                        <mxPoint as="offset" />
                    </mxGeometry>
                </mxCell>

            </root>
        </mxGraphModel>
    </diagram>
