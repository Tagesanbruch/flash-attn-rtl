@article{Zervakis2021,
abstract = {In this work, we introduce a control variate approximation technique for low error approximate Deep Neural Network (DNN) accelerators. The control variate technique is used in Monte Carlo methods to achieve variance reduction. Our approach significantly decreases the induced error due to approximate multiplications in DNN inference, without requiring time-exhaustive retraining compared to state-of-the-art. Leveraging our control variate method, we use highly approximated multipliers to generate power-optimized DNN accelerators. Our experimental evaluation on six DNNs, for Cifar-10 and Cifar100 datasets, demonstrates that, compared to the accurate design, our control variate approximation achieves same performance and 24% power reduction for a merely 0.16% accuracy loss.},
author = {Zervakis, Georgios and Spantidi, Ourania and Anagnostopoulos, Iraklis and Amrouch, Hussam and Henkel, Jorg},
doi = {10.1109/DAC18074.2021.9586092},
file = {:home/lleon95/Downloads/Control_Variate_Approximation_for_DNN_Accelerators.pdf:pdf},
isbn = {9781665432740},
issn = {0738100X},
journal = {Proceedings - Design Automation Conference},
keywords = {Approximate Computing,Arithmetic Circuits,Control Variate,Deep Neural Networks,Low Power,MAC Array},
mendeley-groups = {Paper-references/ESL},
pages = {481--486},
title = {{Control Variate Approximation for DNN Accelerators}},
volume = {2021-December},
year = {2021}
}

@article{Tasoulas2020,
abstract = {Current research in the area of Neural Networks (NN) has resulted in performance advancements for a variety of complex problems. Especially, embedded system applications rely more and more on the utilization of convolutional NNs to provide services such as image/audio classification and object detection. The core arithmetic computation performed during NN inference is the multiply-accumulate (MAC) operation. In order to meet tighter and tighter throughput constraints, NN accelerators integrate thousands of MAC units resulting in a significant increase in power consumption. Approximate computing is established as a design alternative to improve the efficiency of computing systems by trading computational accuracy for high energy savings. In this work, we bring approximate computing principles and NN inference together by designing NN specific approximate multipliers that feature multiple accuracy levels at run-time. We propose a time-efficient automated framework for mapping the NN weights to the accuracy levels of the approximate reconfigurable accelerator. The proposed weight-oriented approximation mapping is able to satisfy tight accuracy loss thresholds, while significantly reducing energy consumption without any need for intensive NN retraining. Our approach is evaluated against several NNs demonstrating that it delivers high energy savings (17.8% on average) with a minimal loss in inference accuracy (0.5%).},
author = {Tasoulas, Zois Gerasimos and Zervakis, Georgios and Anagnostopoulos, Iraklis and Amrouch, Hussam and Henkel, Jorg},
doi = {10.1109/TCSI.2020.3019460},
file = {:home/lleon95/Downloads/Weight_Oriented_Approximation_for_Energy_Efficient_Neural_Network.pdf:pdf},
issn = {15580806},
journal = {IEEE Transactions on Circuits and Systems I: Regular Papers},
keywords = {Approximate computing,low-power,neural network inference,reconfigurable approximate multipliers},
mendeley-groups = {Paper-references/ESL},
number = {12},
pages = {4670--4683},
title = {{Weight-Oriented Approximation for Energy-Efficient Neural Network Inference Accelerators}},
volume = {67},
year = {2020}
}

